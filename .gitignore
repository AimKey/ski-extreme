# This .gitignore file should be placed at the root of your Unity project directory

# Ignore the following folders and files

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Asset meta data should be tracked, but not auto-generated files like .pidb, .pdb, etc.
*.pidb
*.pdb
*.mdb

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# OS generated files
.DS_Store
Thumbs.db

# Crashlytics generated file
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Rider cache directory
.idea/

# User-specific files
*.suo
*.user
*.userprefs
*.csproj
*.unityproj
*.sln
*.tmp
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Package Manager
/[Aa]ssets/AddressableAssetsData/*
/[Aa]ssets/Addressables_Temp*

# Memory Captures
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/

# Ignore Blender temp files
*.blend1
*.blend1.meta

# Ignore auto-generated test scenes
InitTestScene*.unity*

# Others
*.log

